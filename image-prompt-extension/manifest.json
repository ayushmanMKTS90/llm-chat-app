{
  "manifest_version": 3,
  "name": "Image Prompt Generator (NVIDIA)",
  "version": "1.0.0",
  "description": "Right-click any image to generate a prompt using NVIDIA NIM vision models",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://integrate.api.nvidia.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Image Prompt Generator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}